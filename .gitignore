# yeast-GEM specific #
###################
yetfl_metG.csv
yetfl_rxnG.csv
YMDBtemp/

# Release-only files: tracked on main, stamped at release time. Ignored
# here (like *.mat/*.xls* below) so a stray `git add` on develop cannot
# re-track them -- branch-hygiene.yml is what actually enforces this on
# a merge, since .gitignore only applies to untracked paths.
version.txt

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea

