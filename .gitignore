# yeast-GEM specific #
###################
yetfl_metG.csv
yetfl_rxnG.csv
YMDBtemp/

# verify_annotations.py's MetaNetX reference-table cache: ~200MB,
# downloaded once and regenerable, never committed.
data/databases/.metanetx/

# Release-only files: tracked on main, stamped at release time. Ignored
# here (like *.mat/*.xls* below) so a stray `git add` on develop cannot
# re-track them -- branch-hygiene.yml is what actually enforces this on
# a merge, since .gitignore only applies to untracked paths.
version.txt

# model/yeast-GEM.xml and .txt: generated from model/yeast-GEM.yml by
# commitYeastModel/commit_yeast_model (yeast-GEM#379 stage 2), or produced
# at release time -- not tracked on develop, same reasoning as version.txt.
model/yeast-GEM.xml
model/yeast-GEM.txt

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

