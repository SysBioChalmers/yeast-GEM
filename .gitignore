##########################
*.asv
*.m~
*.mex*
*.mlappinstall
*.mltbx
*.mat
helpsearch*/

# Python-related things #
#########################
*.ipynb_checkpoints/
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
*.env

